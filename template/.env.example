# Production (set these in your Vercel project, not in a committed file).
# Neon Postgres connection string. Leave unset locally: the portal uses an embedded PGlite database.
DATABASE_URL=
# Long random string that signs the session cookie. Required in production.
SESSION_SECRET=
# The admin sign-in code. Use a random XXXX-XXXX code, not a word.
ADMIN_CODE=

# Previews only: forces a throwaway in-memory database seeded with demo data (event code TEST, judge JUDG-TEST).
# Never set this in production.
# PORTAL_DB=memory
